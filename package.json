{
  "name": "boss-hyperlounge-pos",
  "version": "1.0.5",
  "description": "BOSS Hyperlounge club/lounge POS — member cards, tables, KOT, billing, offline-first",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "THE BOSS",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && node scripts/copy-schema.mjs && vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && node scripts/dist-win.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx scripts/start.ts",
    "build:start": "npm run build && npm start",
    "seed": "tsx src/server/db/seed.ts"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vitest": "^2.1.8",
    "electron": "36.9.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.theboss.pos",
    "productName": "THE BOSS POS",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data/hyperlounge.sqlite",
        "to": "data/hyperlounge.sqlite"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/app-icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    }
  }
}
